EcruteakCity_Theater_hns_MapScripts::
	.byte 0

PoxEcruteak_EcruteakCity_Theater_hns_0::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_0_Text, MSGBOX_NPC
	end
PoxEcruteak_EcruteakCity_Theater_hns_0_Text:
	.string "The band tunes to the room, not to\nthe stage. The room is always a\nplittle sharp.$"

PoxEcruteak_EcruteakCity_Theater_hns_1::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_1_Text, MSGBOX_NPC
	end
PoxEcruteak_EcruteakCity_Theater_hns_1_Text:
	.string "The FANS hold a trance here every\nevening. They are not watching us.\pThey are watching the space\nbetween us.$"

PoxEcruteak_EcruteakCity_Theater_hns_2::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_2_Text, MSGBOX_NPC
	end
PoxEcruteak_EcruteakCity_Theater_hns_2_Text:
	.string "The theatre is loud even when\nnobody is playing. Stand in the\npright corner and you can hear the\nlast song in the walls.$"

PoxEcruteak_EcruteakCity_Theater_hns_3::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_3_Text, MSGBOX_NPC
	end
PoxEcruteak_EcruteakCity_Theater_hns_3_Text:
	.string "The troupe has danced here since\nbefore the fire. The stage is open\pto anyone who can keep the count.$"

PoxEcruteak_EcruteakCity_Theater_hns_4::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_4_Text, MSGBOX_NPC
	end
PoxEcruteak_EcruteakCity_Theater_hns_4_Text:
	.string "We rehearse the moon step at dusk,\nwhen the lamps are lit but the\pdoors are still shut.\pYou are early. Or we are late.$"

PoxEcruteak_EcruteakCity_Theater_hns_5::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_5_Text, MSGBOX_NPC
	end
PoxEcruteak_EcruteakCity_Theater_hns_5_Text:
	.string "I sell the tickets, I sweep the\nfloor, and I tell the dancers the\npceiling is leaking again.\pIt leaks in the same place every\nyear. They dance around it.$"

PoxEcruteak_EcruteakCity_Theater_hns_6::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_6_Text, MSGBOX_NPC
	end
PoxEcruteak_EcruteakCity_Theater_hns_6_Text:
	.string "The second bell is the one that\nmatters. After it, the music stops\npbeing practice.$"

PoxEcruteak_EcruteakCity_Theater_hns_7::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_7_Text, MSGBOX_NPC
	end
PoxEcruteak_EcruteakCity_Theater_hns_7_Text:
	.string "My grandfather carved the stage\nposts. He said the wood has to be\npolder than the dancer.\pThese posts are not old enough.\nNobody tells the dancers.$"

PoxEcruteak_EcruteakCity_Theater_hns_8::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_8_Text, MSGBOX_NPC
	end
PoxEcruteak_EcruteakCity_Theater_hns_8_Text:
	.string "I have heard the rite every year\nsince I was a boy. It changes by\npone turn each season.\pNobody will admit to changing it.$"

PoxEcruteak_EcruteakCity_Theater_hns_9::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_9_Text, MSGBOX_NPC
	end
PoxEcruteak_EcruteakCity_Theater_hns_9_Text:
	.string "I know all five steps. I am not\nallowed to dance them yet, because\pthe last one is a secret.\pI will show you anyway. Next year.$"

PoxEcruteak_EcruteakCity_Theater_hns_Sign0::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_Sign0_Text, MSGBOX_SIGN
	end
PoxEcruteak_EcruteakCity_Theater_hns_Sign0_Text:
	.string "ECRUTEAK DANCE THEATER\nThe KIMONO troupe performs here.\pSecond bell, every evening.\nMind the step at the door.$"

PoxEcruteak_EcruteakCity_Theater_hns_Sign1::
	msgbox PoxEcruteak_EcruteakCity_Theater_hns_Sign1_Text, MSGBOX_SIGN
	end
PoxEcruteak_EcruteakCity_Theater_hns_Sign1_Text:
	.string "ECRUTEAK DANCE THEATER\nPrograms are posted at the door.\pTonight: the moon step, and\nwhatever the band decides after.$"
