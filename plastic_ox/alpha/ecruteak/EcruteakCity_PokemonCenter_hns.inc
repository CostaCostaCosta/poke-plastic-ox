	release
	end
PoxEcruteak_EcruteakCity_PokemonCenter_hns_3_Text:
	.string "People come to ECRUTEAK to ask the\nSAGES about their families.\pThe SAGES are polite about it.\nThey are also usually out walking.$"

PoxEcruteak_EcruteakCity_PokemonCenter_hns_4::
