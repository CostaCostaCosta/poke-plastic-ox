{
  "_doc": "Which tool owns which files. Edit the SOURCE column, then run the generator; never hand-edit an output without also changing its generator, or the next regeneration silently reverts you. `make pox-generated` reports drift. Build-time outputs (build_time: true) are regenerated by `make` and are gitignored or overwritten every build.",
  "generators": [
    {
      "name": "story",
      "command": "python3 plastic_ox/alpha/build_story.py > /tmp/story.patch  # emits an apply_patch patch; --check verifies",
      "sources": [
        "plastic_ox/alpha/build_story.py",
        "plastic_ox/alpha/region_v7.py",
        "plastic_ox/alpha/league.py",
        "plastic_ox/alpha/story_flags.json",
        "plastic_ox/alpha/region_ports.json",
        "plastic_ox/alpha/*.py (per-area modules)"
      ],
      "outputs": [
        "data/maps/<story maps>/map.json (object/warp/coord events it declares)",
        "data/maps/<story maps>/scripts.inc",
        "data/scripts/plastic_ox_*.inc",
        "include/constants/opponents.h (trainer counts)",
        "src/data/trainers.party (TRAINER_PLASTIC_OX_* blocks)",
        "plastic_ox/alpha/story_manifest.json",
        "plastic_ox/alpha/region_manifest.json"
      ],
      "drift_check": "plastic_ox/tools/check_generated.py (baseline: plastic_ox/generated_drift_baseline.txt)"
    },
    {
      "name": "trainer-teams",
      "command": "python3 plastic_ox/tools/apply_trainer_teams_v2.py",
      "sources": [
        "plastic_ox/tools/apply_trainer_teams_v2.py",
        "plastic_ox/tools/pox_progression.py"
      ],
      "outputs": [
        "src/data/trainers.party (route trainer parties)",
        "plastic_ox/tools/trainer_teams_v2_build.json"
      ],
      "test": "python3 plastic_ox/tools/test_trainer_teams_v2.py"
    },
    {
      "name": "wiki",
      "command": "python3 plastic_ox/wiki/build_wiki.py",
      "sources": [
        "plastic_ox/wiki/build_wiki.py",
        "plastic_ox/wiki/assets/*",
        "plastic_ox/story/locations/*.md",
        "data/maps/**",
        "src/data/**"
      ],
      "outputs": [
        "plastic_ox/wiki/site/ (untracked; CI uploads it as the plastic-ox-wiki artifact)"
      ]
    },
    {
      "name": "title-art",
      "command": "python3 plastic_ox/title/generate_art.py",
      "sources": [
        "plastic_ox/title/generate_art.py"
      ],
      "outputs": [
        "src/data/plastic_ox_title_art.h"
      ]
    },
    {
      "name": "metamon-model",
      "command": "see plastic_ox/battle/metamon/README.md (import_model.py)",
      "sources": [
        "external metamon export"
      ],
      "outputs": [
        "plastic_ox/battle/metamon/model/*"
      ]
    },
    {
      "name": "trainerproc",
      "build_time": true,
      "sources": [
        "src/data/trainers.party"
      ],
      "outputs": [
        "src/data/trainers.h"
      ]
    },
    {
      "name": "mapjson",
      "build_time": true,
      "sources": [
        "data/maps/*/map.json",
        "data/layouts/layouts.json"
      ],
      "outputs": [
        "data/maps/*/events.inc",
        "data/maps/*/header.inc",
        "data/maps/*/connections.inc",
        "include/constants/map_groups.h",
        "include/constants/layouts.h"
      ]
    },
    {
      "name": "fly-map",
      "command": "python3 plastic_ox/town_map/build_fly_map.py  # --check verifies",
      "sources": [
        "plastic_ox/town_map/build_fly_map.py (v7 grid layout, fly spots)",
        "plastic_ox/town_map/plastic_ox_town_map_unlabeled.png (terrain)"
      ],
      "outputs": [
        "graphics/pokenav/region_map/map.png",
        "graphics/pokenav/region_map/map.bin",
        "graphics/pokenav/region_map/map.pal",
        "src/data/region_map/region_map_layout.h",
        "src/data/region_map/region_map_sections.json (x/y/width/height of placed map sections)",
        "src/data/region_map/plastic_ox_fly_spots.h",
        "plastic_ox/town_map/fly_map_preview.png"
      ],
      "drift_check": "python3 plastic_ox/town_map/build_fly_map.py --check (run by pox-check-static)"
    }
  ]
}
