@ Same shape as build_story.battle(): talking resumes an interrupted reward.
Pox_TowerGrunt3::
	goto_if_unset FLAG_POX_TRIGGERS_ENABLED, Pox_End
	lockall
	goto_if_unset FLAG_POX_HIDE_LAVENDER_GRUNT_2, Pox_NotReady
	goto_if_set FLAG_POX_HIDE_LAVENDER_GRUNT_3, Pox_Done
	trainerbattle_single TRAINER_PLASTIC_OX_TOWERGRUNT3, PoxLavender_Text_Grunt3Intro, PoxLavender_Text_Grunt3Defeat, Pox_TowerGrunt3_Won
	goto Pox_TowerGrunt3_Won
Pox_TowerGrunt3_Won::
	setflag FLAG_POX_HIDE_LAVENDER_GRUNT_3
	removeobject VAR_LAST_TALKED
	releaseall
	end

