PoxFrontier_LC_Attendant::
	lock
	faceplayer
	call_if_set FLAG_POX_FRONTIER_CLEARED_LC, PoxFrontier_LC_Again
	call_if_unset FLAG_POX_FRONTIER_CLEARED_LC, PoxFrontier_LC_Welcome
	goto_if_eq VAR_RESULT, NO, PoxFrontier_LC_Declined
	setvar VAR_0x8004, 0
	specialvar VAR_RESULT, PoxFrontier_CheckRules
	goto_if_ne VAR_RESULT, 0, PoxFrontier_LC_Refuse
	setvar VAR_0x8004, 0
	special PoxFrontier_Begin
	msgbox PoxFrontier_LC_Text_Begin, MSGBOX_DEFAULT
PoxFrontier_LC_Next::
	special PoxFrontier_NextOpponent
	msgbox PoxFrontier_LC_Text_Opponent, MSGBOX_DEFAULT
	closemessage
	cleartrainerflag TRAINER_PLASTIC_OX_FRONTIER_LC
	trainerbattle_no_intro TRAINER_PLASTIC_OX_FRONTIER_LC, PoxFrontier_LC_Text_Defeat
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_WON, PoxFrontier_LC_Lost
	special HealPlayerParty
	specialvar VAR_RESULT, PoxFrontier_RecordWin
	goto_if_eq VAR_RESULT, TRUE, PoxFrontier_LC_Cleared
	msgbox PoxFrontier_LC_Text_Continue, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, PoxFrontier_LC_Retire
	goto PoxFrontier_LC_Next
PoxFrontier_LC_Cleared::
	setflag FLAG_POX_FRONTIER_CLEARED_LC
	special PoxFrontier_End
	playfanfare MUS_OBTAIN_SYMBOL
	msgbox PoxFrontier_LC_Text_Cleared, MSGBOX_DEFAULT
	waitfanfare
	release
	end
