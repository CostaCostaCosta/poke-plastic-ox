@ Stepping into the boardroom walks the player up to GIOVANNI and starts his
@ battle. A coord trigger has no selected object event, which the ordinary
@ trainerbattle intro asserts on, so this path shows the intro itself and
@ uses trainerbattle_no_intro; the victory script is the same either way.
PoxSaffron_GiovanniTriggerLeft::
	lockall
	goto_if_set FLAG_POX_HIDE_SILPH_GIOVANNI, PoxSaffron_GiovanniTriggerOff
	goto_if_unset FLAG_POX_TRIGGERS_ENABLED, PoxSaffron_GiovanniTriggerOff
	applymovement LOCALID_PLAYER, PoxSaffron_Move_GiovanniLeft
	waitmovement 0
	goto PoxSaffron_GiovanniApproach
PoxSaffron_GiovanniTriggerRight::
	lockall
	goto_if_set FLAG_POX_HIDE_SILPH_GIOVANNI, PoxSaffron_GiovanniTriggerOff
	goto_if_unset FLAG_POX_TRIGGERS_ENABLED, PoxSaffron_GiovanniTriggerOff
	applymovement LOCALID_PLAYER, PoxSaffron_Move_GiovanniRight
	waitmovement 0
PoxSaffron_GiovanniApproach::
