@ Reveal-ladder step 14, and the only place the system is named. The terminal
@ reports status; it never addresses the player. The merged region stays.
Pox_SilphCore::
	goto_if_unset FLAG_POX_TRIGGERS_ENABLED, Pox_End
	lockall
	goto_if_unset FLAG_POX_HIDE_SILPH_GIOVANNI, PoxSaffron_CoreLocked
	goto_if_set FLAG_POX_STORY_SILPH, PoxSaffron_CoreDone
	msgbox PoxSaffron_Text_Core1, MSGBOX_DEFAULT
	msgbox PoxSaffron_Text_CoreAsk, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, PoxSaffron_CoreNo
	playse SE_PC_OFF
	msgbox PoxSaffron_Text_Core2, MSGBOX_DEFAULT
	setflag FLAG_POX_STORY_SILPH
	closemessage
	fadescreen FADE_TO_BLACK
	clearflag FLAG_POX_HIDE_SILPH_STAFF
	addobject LOCALID_POX_SILPH_PRESIDENT
	addobject LOCALID_POX_SILPH_SECRETARY
	fadescreen FADE_FROM_BLACK
	msgbox PoxSaffron_Text_CoreStaff, MSGBOX_DEFAULT
	releaseall
