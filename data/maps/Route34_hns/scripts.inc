Route34_EventScript_Npc1_Text:
	.string "Down south the grass turns tropical.\nSame planet, apparently.$"

Route34_EventScript_Npc2_Text:
	.string "I train here because the wild POKEMON\nargue about which region they're in.$"

Route34_EventScript_Npc3_Text:
	.string "Race you to HOENN! It's that way.\nOr that way. It's always that way.$"

Route34_EventScript_Npc4_Text:
	.string "My RATTATA knows a shortcut through\nthe woods that skips three towns.$"

Route34_EventScript_Npc5_Text:
	.string "They say a GYM town sits past the\nfields east of here. Different badge,\nsame league.$"

Route34_EventScript_Npc6_Text:
	.string "The DAY-CARE moved twice this year.\nIt's technically in two regions now.$"

Route34_EventScript_Npc7_Text:
	.string "Keep east for GOLDENROD... or was it\nRUSTBORO? The signs gave up.$"

Route34_EventScript_Npc8_Text:
	.string "Roads keep ending somewhere they\ndidn't used to.$"

Route34_EventScript_Npc9_Text:
	.string "Roads keep ending somewhere they\ndidn't used to.$"

Route34_EventScript_Npc10_Text:
	.string "Roads keep ending somewhere they\ndidn't used to.$"

Route34_EventScript_Npc11_Text:
	.string "I nap here. The border runs right\nthrough my blanket.$"

Route34_EventScript_Npc12_Text:
	.string "This route used to just end. Now it's\nsomebody's shortcut.$"

Route34_EventScript_Npc13_Text:
	.string "Roads keep ending somewhere they\ndidn't used to.$"

Route34_EventScript_Sign1_Text:
	.string "ROUTE 34\nNorth: ILEX FOREST. South: anywhere.$"

Route34_EventScript_Sign2_Text:
	.string "ROUTE 34\nDAY-CARE: now serving both regions.$"

Route34_EventScript_Sign3_Text:
	.string "ROUTE 34\nGOLDENROD CITY straight ahead.$"

Route34_EventScript_Sign4_Text:
	.string "ROUTE 34\nWatch for trainers crossing regions.$"
