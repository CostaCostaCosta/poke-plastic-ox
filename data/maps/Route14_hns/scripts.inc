Route14_EventScript_Npc1_Text:
	.string "A thin tree. A feather is caught\nin its bark.$"

Route14_EventScript_Npc2_Text:
	.string "South! GOLDENROD. Bright lights, loud\ntrains, trains to nowhere.$"

Route14_EventScript_Npc3_Text:
	.string "A thin tree. The grass around\nits trunk has been trampled\pflat.$"

Route14_EventScript_Npc4_Text:
	.string "My crew rides coast to coast now.\nTook a week to learn the turns.$"

Route14_EventScript_Npc5_Text:
	.string "I walk this road every evening.\nThe bird POKéMON overhead have\pbecome old friends.$"

Route14_EventScript_Npc6_Text:
	.string "A thin tree. Someone has carved\na small arrow pointing south\pinto it.$"

Route14_EventScript_Npc7_Text:
	.string "A thin tree. An empty nest sits\nin the fork of its branches.$"

Route14_EventScript_Npc8_Text:
	.string "A thin tree, standing on its\nown. It sways even when the\pbreeze drops.$"

